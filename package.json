{
  "name": "ghoststate",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "A local-first, user-controlled authentication workflow assistant",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "test": "vitest run",
    "test:browser": "node tests/e2e/extension.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "node scripts/package.mjs",
    "audit": "npm audit --omit=dev",
    "test:native": "node tests/integration/native-host.mjs",
    "test:permission": "xvfb-run -a -s \"-screen 0 1440x1000x24\" node tests/e2e/permission-prompt.mjs",
    "audit:rust": "python3 scripts/audit-rust-osv.py",
    "test:installer": "node tests/integration/install-native.mjs",
    "test:firefox": "python3 tests/e2e/firefox.py",
    "test:firefox-consent": "xvfb-run -a -s \"-screen 0 1440x1000x24\" python3 tests/e2e/firefox-consent.py",
    "test:dashboard": "node tests/e2e/dashboard.mjs",
    "test:a11y": "node tests/e2e/accessibility.mjs",
    "test:autofill": "node tests/e2e/autofill.mjs",
    "test:responsive": "node tests/e2e/responsive.mjs",
    "test:responsive:firefox": "node tests/e2e/responsive-engines.mjs firefox",
    "test:responsive:webkit": "node tests/e2e/responsive-engines.mjs webkit",
    "test:native-ui": "node tests/e2e/native-diagnostics.mjs",
    "test:store-assets": "node scripts/capture-store-assets.mjs",
    "test:public-demo": "node tests/e2e/public-demo.mjs",
    "guide:pdf": "node scripts/render-guide.mjs",
    "test:release": "node tests/integration/release-packages.mjs",
    "test:native-permission": "xvfb-run -a -s \"-screen 0 1440x1000x24\" node tests/e2e/native-permission-prompt.mjs",
    "test:native-bridge": "xvfb-run -a -s \"-screen 0 1440x1000x24\" node tests/e2e/native-bridge-transfer.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.30",
    "axe-core": "4.14.1",
    "esbuild": "^0.25.5",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.52.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
}
